# ============================================================
#  FLAMA DISTRIBUIDORA — .env
#  Copiá este archivo como .env y completá con tus datos
#  NUNCA subas el .env real a GitHub
# ============================================================

# ---- Servidor ----
PORT=3001
NODE_ENV=production

# ---- Base de datos MySQL (Railway te los da automáticamente) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=flama_db

# ---- JWT ----
# Generá una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura
JWT_EXPIRES=7d

# ---- Frontend (CORS) ----
# En producción: tu dominio real
FRONTEND_URL=https://flamadistri.ar
